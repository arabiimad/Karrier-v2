CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ===== Optional Integrations =====
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
