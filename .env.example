# ===== Auth =====
ADMIN_PASSWORD_HASH=$2a$10$xxx
JWT_SECRET=your-jwt-secret-here

# ===== Email (Resend) =====
RESEND_API_KEY=re_xxx
ADMIN_EMAIL=admin@example.com

# ===== Vercel KV / Redis =====
KV_REST_API_URL=https://xxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxx

# ===== Site =====
